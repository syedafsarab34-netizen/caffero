# Copy this file to .env and replace the example values before production use.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
CAFFERO_ADMIN_EMAIL=you@example.com
CAFFERO_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
CAFFERO_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Optional in production; set to the exact HTTPS origin, for example https://caffero.onrender.com
CAFFERO_ORIGIN=
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
CAFFERO_TRUST_PROXY=false
# Optional; defaults are data/caffero.sqlite and public/uploads.
# CAFFERO_DATABASE=./data/caffero.sqlite
# CAFFERO_UPLOADS_DIRECTORY=./public/uploads
